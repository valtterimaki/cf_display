{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run sketch",
      "type": "process",
      "windows": {
        "command": "C:\\Program Files\\Processing\\Processing.exe"
      },
      "osx": {
        "command": "/Applications/Processing.app/Contents/MacOS/Processing"
      },
      "args": ["cli", "--sketch=${workspaceFolder}", "--run"],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    }
  ]
}
